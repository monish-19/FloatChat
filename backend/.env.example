APP_NAME=FloatChat
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=floatchat
NEO4J_DATABASE=neo4j
DATABASE_URL=postgresql+psycopg://floatchat:floatchat@localhost:5432/floatchat
ARGO_SOURCE=erddap
ARGO_ERDDAP_URL=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats.nc
# Optional projection; time and Indian Ocean geographic constraints are added automatically.
# ARGO_ERDDAP_QUERY=JULD,LATITUDE,LONGITUDE,PLATFORM_NUMBER,CYCLE_NUMBER,PRES,TEMP,PSAL,DOXY,CHLA,PRES_QC
ARGO_LOOKBACK_HOURS=24
ARGO_REQUEST_TIMEOUT=90
# Optional grounded LLM fallback for unsupported/open-ended questions.
FLOATCHAT_LLM_PROVIDER=openai
OPENAI_API_KEY=
FLOATCHAT_LLM_MODEL=gpt-4o-mini
FLOATCHAT_LLM_TIMEOUT_SECONDS=20
# For GDAC, set ARGO_SOURCE=gdac and provide a direct .nc URL or URL template.
# ARGO_GDAC_URL=https://data-argo.ifremer.fr/...
